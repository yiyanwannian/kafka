    participant "RequestChannel" as RC
end box

box "Request Processing" #LightYellow
    participant "KafkaRequestHandler" as KRH
    participant "KafkaApis" as APIS
end box

box "Storage & Replication" #LightCoral
    participant "ReplicaManager" as RM
    participant "LogManager" as LM
    participant "UnifiedLog" as UL
    participant "LogSegment" as LS
end box

box "Consumer Flow" #LightCyan
    participant "KafkaConsumer" as KCONS
    participant "ClassicKafkaConsumer" as CKC
    participant "Fetcher" as FETCHER
end box

