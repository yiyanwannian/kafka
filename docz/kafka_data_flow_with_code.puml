@startuml Kafka Data Flow with Code Locations
!theme plain
skinparam backgroundColor #FFFFFF

title Kafka 数据流处理图 (含代码位置)

actor "Producer Client" as PROD_CLIENT
actor "Consumer Client" as CONS_CLIENT
actor "Admin Client" as ADMIN_CLIENT

box "Producer Flow" #LightBlue
    participant "KafkaProducer" as KPROD
    participant "ProducerInterceptors" as PI
    participant "RecordAccumulator" as RA
    participant "Sender" as SENDER
end box

box "Network Layer" #LightGreen
    participant "SocketServer" as SS
    participant "Acceptor" as ACC
