                **路径**: core/src/main/scala/kafka/network/SocketServer.scala
                **功能**: 网络层处理
            }
            
            class "RequestChannel.scala" as RC {
                + sendRequest(request: Request)
                + receiveRequest(): Request
                --
                **路径**: core/src/main/scala/kafka/network/RequestChannel.scala
                **功能**: 请求通道
            }
        }
        
        package "kafka.log" {
            class "LogManager.scala" as LM {
