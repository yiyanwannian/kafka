package "Core Server Modules" {
    
    package "core/" {
        package "kafka.server" {
            class "Kafka.scala" as MAIN {
                + main(args: Array[String])
                + buildServer(props: Properties): Server
                --
                **路径**: core/src/main/scala/kafka/Kafka.scala
                **功能**: 服务器启动入口
            }
            
            class "KafkaRaftServer.scala" as KRS {
                + startup(): Unit
                + shutdown(): Unit
                --
                **路径**: core/src/main/scala/kafka/server/KafkaRaftServer.scala
                **功能**: KRaft模式服务器
            }
            
            class "BrokerServer.scala" as BS {
                + startup(): Unit
                + replicaManager: ReplicaManager
                + logManager: LogManager
                --
                **路径**: core/src/main/scala/kafka/server/BrokerServer.scala
                **功能**: Broker实现
            }
            
            class "KafkaApis.scala" as APIS {
                + handle(request: RequestChannel.Request)
                + handleProduceRequest()
                + handleFetchRequest()
                --
                **路径**: core/src/main/scala/kafka/server/KafkaApis.scala
                **功能**: API请求处理
            }
            
            class "ReplicaManager.scala" as RM {
                + appendRecords()
                + fetchMessages()
                + becomeLeaderOrFollower()
                --
                **路径**: core/src/main/scala/kafka/server/ReplicaManager.scala
                **功能**: 副本管理
            }
        }
        
        package "kafka.network" {
            class "SocketServer.scala" as SS {
                + startup(): Unit
